#!/usr/bin/env bash
# post-commit — auto-sync plugin artifacts to the live Obsidian vault.
# Installed via: git config core.hooksPath plugin/hooks
#
# This hook runs after every `git commit`. It delegates to sync.mjs so the
# behavior is identical to a manual `npm run sync` invocation.
#
# To disable temporarily:  git config core.hooksPath .git/hooks
# To re-enable:            git config core.hooksPath plugin/hooks
#
# Deliberately NOT using `set -e`: the commit has already been created by the
# time this runs, so a sync problem must not be reported as a failed commit.

# Resolve repo root in Windows-style path (Node on Windows needs the drive
# letter, not POSIX-style /d/... — `pwd -W` is a Git Bash / MSYS extension).
REPO_ROOT="$(cd "$(dirname "$0")/../.." && pwd -W)"
SYNC_SCRIPT="$REPO_ROOT\\plugin\\scripts\\sync.mjs"

if [ ! -f "$SYNC_SCRIPT" ]; then
  echo "[obsidian-mineru] post-commit: sync.mjs not found at $SYNC_SCRIPT — skipping."
  exit 0
fi

# Only sync when the commit touched plugin/ source files. This avoids pointless
# copies when only docs/ or code/ changed.
CHANGED_IN_PLUGIN=$(git diff-tree --no-commit-id --name-only -r HEAD | grep -E '^plugin/' | wc -l | tr -d ' ')

if [ "$CHANGED_IN_PLUGIN" = "0" ]; then
  exit 0
fi

# Resolve a node binary. The hook inherits whatever PATH git was started with,
# which is not guaranteed to include node (git is often launched by Obsidian
# rather than from a shell), so fall back to the usual install locations.
NODE_BIN="$(command -v node 2>/dev/null || true)"
if [ -z "$NODE_BIN" ]; then
  for candidate in "/d/nodejs/node.exe" "/c/Program Files/nodejs/node.exe"; do
    if [ -x "$candidate" ]; then
      NODE_BIN="$candidate"
      break
    fi
  done
fi

if [ -z "$NODE_BIN" ]; then
  echo "[obsidian-mineru] post-commit: node not found — skipping vault sync."
  echo "[obsidian-mineru] install Node.js, or run 'npm run sync' where node is available."
  exit 0
fi

echo "[obsidian-mineru] post-commit: plugin/ changed in this commit — syncing to the Obsidian vault..."

if ! "$NODE_BIN" "$SYNC_SCRIPT"; then
  echo "[obsidian-mineru] post-commit: sync failed (see above)."
  echo "[obsidian-mineru] the commit itself succeeded; run 'npm run sync' to retry."
fi

exit 0
