# vscode / cursor / ide
.vscode/
.idea/
*.iml

# node / npm
**/node_modules/

# Obsidian plugin build artifacts (re-generated by `npm run build`)
# Per AGENTS.md and Obsidian community convention, do NOT commit main.js.
plugin/main.js
plugin/*.map

# Obsidian vault data — never commit
data.json

# OS
.DS_Store
Thumbs.db

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.venv/
venv/

# Logs / scratch
*.log
nul

# Sensitive — never commit API keys or tokens
*.env
.env*
secrets.*

# WorkBuddy workspace memory (this repo is the workspace root)
.workbuddy/