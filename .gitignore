# vscode / cursor / ide
.vscode/
.idea/
*.iml

# node / npm
**/node_modules/

# Obsidian plugin build artifacts (re-generated by `npm run build`)
# Obsidian community convention: do NOT commit main.js; upload to GitHub releases instead.
plugin/main.js
plugin/*.map

# Local release zips (stale build outputs — releases are published by CI)
plugin/*.zip

# Obsidian vault data — never commit
data.json

# OS
.DS_Store
Thumbs.db

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.venv/
venv/

# Logs / scratch
*.log
nul

# Sensitive — never commit API keys or tokens
*.env
.env*
secrets.*

# WorkBuddy workspace memory (this repo is the workspace root)
# AI assistant working folders — never commit
.workbuddy/
.claude/
.agents/
# macOS design sources (not needed at runtime; recoverable from git history)
*@2x.png
*_2K_*.jpeg
